{
  "name": "@botskills/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"tests/**/*.mjs\" \"*.{ts,mjs,json}\" \"!src/app/blog/posts/**\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"tests/**/*.mjs\" \"*.{ts,mjs,json}\" \"!src/app/blog/posts/**\""
  },
  "dependencies": {
    "@botskills/shared": "workspace:*",
    "@neondatabase/serverless": "^0.10.0",
    "drizzle-orm": "^0.36.0",
    "mermaid": "^11.17.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "resend": "^6.25.0",
    "simple-icons": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "prettier": "^3",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "24.x"
  }
}
